# live graph store of this repo (root only; never commit, see DEC-001).
# The sample's built store under samples/ IS committed.
/.sdd/graph/
/.sdd/daemon.json
/.sdd/*.lock
# A writable open recreates .cypherlite.writer; the .cypherlite.lock markers stay in committed
# stores (root and wal/), because a read-only open needs them (D001).
.cypherlite.writer

# secrets
.env
deploy/.env

# python / tooling
__pycache__/
*.pyc
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.import_linter_cache/

# benchmark scratch
bench/results/*.tmp

# playwright MCP output
/playwright/

# claude local settings
.claude/settings.local.json

# polling benchmark scratch (scripts/measure_poll.py deletes it)
/_pollbench/

# static demo build (sdd site)
/site/

# private
/private/
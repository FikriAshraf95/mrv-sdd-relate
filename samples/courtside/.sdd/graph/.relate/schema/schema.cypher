CREATE FULLTEXT INDEX `ft_file_path` FOR (n:`File`) ON EACH [n.`path`] OPTIONS {indexConfig: {`fulltext.analyzer`: 'standard-no-stop-words',`fulltext.eventually_consistent`: false}};
CREATE FULLTEXT INDEX `ft_section_text` FOR (n:`Section`) ON EACH [n.`title`, n.`text`] OPTIONS {indexConfig: {`fulltext.analyzer`: 'standard-no-stop-words',`fulltext.eventually_consistent`: false}};
CREATE RANGE INDEX `idx_event_at` FOR (n:`Event`) ON (n.`at`);
CREATE RANGE INDEX `idx_file_path` FOR (n:`File`) ON (n.`path`);
CREATE RANGE INDEX `idx_section_spec_id` FOR (n:`Section`) ON (n.`spec_id`);
CREATE RANGE INDEX `idx_task_milestone_id` FOR (n:`Task`) ON (n.`milestone_id`);
CREATE RANGE INDEX `idx_task_status` FOR (n:`Task`) ON (n.`status`);
CREATE CONSTRAINT `uniq_acceptancecheck_id` FOR (n:`AcceptanceCheck`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `uniq_agent_id` FOR (n:`Agent`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `uniq_column_id` FOR (n:`Column`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `uniq_commit_id` FOR (n:`Commit`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `uniq_deviation_id` FOR (n:`Deviation`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `uniq_doc_id` FOR (n:`Doc`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `uniq_domain_id` FOR (n:`Domain`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `uniq_event_id` FOR (n:`Event`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `uniq_feature_id` FOR (n:`Feature`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `uniq_file_id` FOR (n:`File`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `uniq_folder_id` FOR (n:`Folder`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `uniq_meta_id` FOR (n:`Meta`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `uniq_milestone_id` FOR (n:`Milestone`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `uniq_section_id` FOR (n:`Section`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `uniq_spec_id` FOR (n:`Spec`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `uniq_table_id` FOR (n:`Table`) REQUIRE (n.`id`) IS UNIQUE;
CREATE CONSTRAINT `uniq_task_id` FOR (n:`Task`) REQUIRE (n.`id`) IS UNIQUE;
